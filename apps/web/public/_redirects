# Redirect literal placeholder query values to home.
# Must come before the generic query redirect below.
/?name=:name  /  302

# Redirect legacy GitHub Pages ?name= URLs to the new SSR route.
# Cloudflare Pages processes these before Pages Functions.
/?name=:name*  /name/:name/  301

# Catch users pasting route templates literally.
/name/%3Aname/  /  302
/name/%3Aname   /  302

# Enforce trailing slash canonical name URLs.
/name/:name  /name/:name/  301

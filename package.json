{
  "name": "nobodynamed",
  "private": true,
  "version": "1.0.0",
  "description": "nobodynamed: SSA baby-name data on the Cloudflare stack (Pages + D1 + Workers)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -w @nv/shared build",
    "typecheck": "tsc -b apps/web apps/ingest-worker packages/shared",
    "dev:web": "npm run -w @nv/web dev",
    "dev:ingest": "npm run -w @nv/ingest-worker dev",
    "deploy:web": "npm run -w @nv/web deploy",
    "deploy:ingest": "npm run -w @nv/ingest-worker deploy",
    "migrations:apply": "wrangler d1 migrations apply name-vitals --remote --config apps/web/wrangler.toml",
    "migrations:apply:local": "wrangler d1 migrations apply name-vitals --local --config apps/web/wrangler.toml",
    "seed": "tsx scripts/seed-from-shards.ts",
    "ingest-ssa": "tsx scripts/ingest-ssa.ts",
    "build-enrichment": "tsx scripts/build-enrichment.ts",
    "seed-enrichment": "tsx scripts/seed-enrichment.ts",
    "seed-enrichment:local": "tsx scripts/seed-enrichment.ts --local",
    "verify-enrichment": "tsx scripts/verify-enrichment.ts",
    "verify-strongholds": "tsx scripts/verify-enrichment-strongholds.ts",
    "verify-parity": "tsx scripts/verify-parity.ts",
    "backfill-rankings": "tsx scripts/backfill-rankings.ts",
    "backfill-rankings:local": "tsx scripts/backfill-rankings.ts --local",
    "backfill-viz-payloads": "tsx scripts/backfill-viz-payloads.ts",
    "verify-diaspora": "tsx scripts/verify-diaspora-percapita.ts",
    "weekly-analytics-report": "tsx scripts/weekly-analytics-report.ts",
    "build-shadow-matches": "tsx scripts/build-shadow-matches.ts",
    "build-decade-hub": "tsx scripts/build-decade-hub.ts",
    "build-decade-hubs": "tsx scripts/build-decade-hubs.ts",
    "sensitivity:decade-hub": "tsx scripts/decade-hub-sensitivity.ts",
    "test:decade-hub": "tsx --test scripts/decade-hub.test.ts scripts/decade-hub-classroom.test.ts scripts/decade-hub-families.test.ts scripts/decade-hub-matrix.test.ts scripts/decade-hub-routes.test.ts scripts/decade-hub-payload.test.ts scripts/decade-hub-1920.test.ts scripts/decade-hub-render-parity.test.ts scripts/decade-hub-definitions.test.ts scripts/decade-hub-build.test.ts",
    "seed-shadow-matches": "tsx scripts/seed-shadow-matches.ts",
    "seed-shadow-matches:local": "tsx scripts/seed-shadow-matches.ts --local",
    "test": "tsc -b apps/ingest-worker packages/shared && npm run test:shell && npm run test:mini-sparkline && npm run test:rankings && npm run test:viz-payloads && npm run test:dominant-name-sparks && npm run test:editorial && npm run test:editorial-growth && npm run test:decade-hub && npm run verify-diaspora && npm run verify-strongholds",
    "test:shell": "tsx --test scripts/render-shell.test.ts",
    "test:mini-sparkline": "tsx --test scripts/mini-sparkline.test.ts",
    "test:rankings": "tsx --test scripts/rankings.test.ts",
    "test:viz-payloads": "tsx --test scripts/viz-payloads.test.ts",
    "test:dominant-name-sparks": "tsx --test scripts/dominant-name-sparks.test.ts",
    "test:editorial": "tsx --test scripts/editorial-pages.test.ts",
    "smoke:prod": "bash scripts/smoke-prod.sh",
    "blog:publish": "tsx scripts/blog-publish.ts",
    "blog:preview": "tsx scripts/blog-publish.ts --stdout",
    "blog:apply:local": "wrangler d1 execute name-vitals --local --config apps/web/wrangler.toml --file",
    "blog:apply:remote": "wrangler d1 execute name-vitals --remote --config apps/web/wrangler.toml --file",
    "blog:test": "tsx --test scripts/blog-publish.test.ts scripts/render-blog.test.ts",
    "test:narrative": "tsx scripts/test-narrative.ts",
    "validate:pages": "tsx scripts/validate-name-pages.ts",
    "audit:links": "tsx scripts/validate-internal-links.ts",
    "audit:site": "npm run audit:links && npm run validate:pages",
    "test:indexable-routes": "tsx --test scripts/indexable-routes.test.ts",
    "test:editorial-growth": "tsx --test scripts/editorial-growth.test.ts",
    "build-decade-hub:1920s": "tsx scripts/build-decade-hub-1920.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "undici": "^7.29.0",
    "wrangler": "^4.85.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelcolenso/babynames.git"
  }
}
